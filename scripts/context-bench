#!/usr/bin/env python3
"""Runs one agent task through the HTTP API (a turn the backend runs, followed until it ends), then prints
the chat's context numbers (scripts/chat-metrics) — the fixed benchmark for context-management changes.

usage: scripts/context-bench --base http://127.0.0.1:3104 --secret JWT_SECRET --prompt-file TASK.md \\
           --profile ID [--user-id 1 --username san3] [--max-rounds 150] [--container tulpa-bench-pg]

Run it against a throwaway backend (never the real stack) and give the task a scratch git
worktree as its working folder, so whatever the agent edits is not the real repo. Every scope the
agent asks for (a folder to read, a command word to run) is granted: the script turns on the user's
auto-confirm, and sets their step limit to --max-rounds (a turn that reaches it ends as `step_limit`).
"""
import argparse, base64, hashlib, hmac, json, subprocess, sys, time, urllib.request, urllib.error

ap = argparse.ArgumentParser()
ap.add_argument("--base", required=True)
ap.add_argument("--secret", required=True, help="the backend's jwt_secret")
ap.add_argument("--prompt-file", required=True)
ap.add_argument("--profile", type=int, required=True, help="launch profile id")
ap.add_argument("--user-id", type=int, default=1)
ap.add_argument("--username", default="san3")
ap.add_argument("--role", default="owner")
ap.add_argument("--max-rounds", type=int, default=150)
ap.add_argument("--name", default="context-bench")
ap.add_argument("--container", default="tulpa-bench-pg")
args = ap.parse_args()


def b64(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=")


def token():
    header = b64(json.dumps({"alg": "HS256", "typ": "JWT"}).encode())
    claims = b64(json.dumps({"sub": args.user_id, "username": args.username, "role": args.role,
                             "exp": int(time.time()) + 86400}).encode())
    signature = b64(hmac.new(args.secret.encode(), header + b"." + claims, hashlib.sha256).digest())
    return (header + b"." + claims + b"." + signature).decode()


TOKEN = token()


def call(path, body=None, method=None):
    request = urllib.request.Request(
        args.base + path,
        data=json.dumps(body).encode() if body is not None else None,
        method=method or ("POST" if body is not None else "GET"),
        headers={"Authorization": "Bearer " + TOKEN, "Content-Type": "application/json"},
    )
    try:
        # A turn can take many minutes (model load, prefill, a long generation)
        with urllib.request.urlopen(request, timeout=3600) as response:
            return json.loads(response.read() or b"null")
    except urllib.error.HTTPError as error:
        sys.exit(f"{path}: HTTP {error.code} {error.read().decode()[:400]}")


def log(message):
    print(time.strftime("%H:%M:%S"), message, file=sys.stderr, flush=True)


chat = call("/api/chats", {"name": args.name, "launch_profile_id": args.profile})
chat_id = chat["id"]
log(f"chat {chat_id} on profile {args.profile}")

prompt = open(args.prompt_file).read()
call("/api/settings", {"auto_confirm": True, "max_turn_steps": args.max_rounds})
started = time.time()
call("/api/agent/turn", {"chat_id": chat_id, "prompt": prompt})
last_step = None
while True:
    time.sleep(2)
    state = call(f"/api/agent/turn?chat_id={chat_id}")
    if state["status"] == "running":
        step = (state["step"], state["running_tool"])
        if step != last_step:
            doing = f"running {state['running_tool']}" if state["running_tool"] else "model call"
            log(f"step {state['step']}: {doing}, {state['eval_tokens']} tokens generated so far")
            last_step = step
        continue
    if state["status"] == "waiting_for_permission":
        # Auto-confirm grants what an escalation offers, so a wait means a call asked for more: granted the same way
        decisions = [{"index": index, "allowance": "permanent"} for index, call_ in enumerate(state["pending"])
                     if call_["permission"]["status"] == "denied" and call_["permission"].get("escalation")]
        log(f"waiting for permission: granting {len(decisions)} call(s)")
        call("/api/agent/answer", {"chat_id": chat_id, "decisions": decisions})
        continue
    end = state["last_end"] or {}
    log(f"run ended: {end.get('reason')}{' - ' + end['detail'] if end.get('detail') else ''}")
    break

messages = call(f"/api/chats/messages?chat_id={chat_id}&limit=5000")["messages"]
replies = sum(1 for m in messages if m["role"] == "assistant")
log(f"done in {(time.time() - started) / 60:.1f} min, {replies} model replies")
print(json.dumps({"chat_id": chat_id, "minutes": round((time.time() - started) / 60, 1), "replies": replies,
                  "end": (state.get("last_end") or {}).get("reason")}))
subprocess.run([sys.executable, __file__.replace("context-bench", "chat-metrics"), str(chat_id), "--container", args.container])

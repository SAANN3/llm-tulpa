# Copy to `.env` in the repo root (gitignored) and edit. Docker Compose reads it for the
# root compose.yaml (the backend's mounts) and for llm/compose.yaml (Ollama), so anything
# both need is written once, here. Every variable is optional.

# Optional: filename of a .gguf model to register as `local-llm` on container start —
# it must sit in this folder (or in MODEL_DIR, if set below). Leave empty to add models
# from the app instead (pull one, or import any .gguf from MODEL_DIR).
MODEL_FILE=

# Optional: a mmproj/CLIP projector .gguf, paired with MODEL_FILE, to give the model
# vision. Leave empty for a plain-text model.
MMPROJ_FILE=

# Optional: folder the .gguf(s) actually live in, if not this one — an absolute path,
# or relative to this folder. Handy for keeping a large model on faster storage than
# wherever this project itself sits. The app imports local models from here too, so the
# backend mounts the same folder: the root compose.yaml reads MODEL_DIR from the root .env,
# so set it *there* (the included llm compose reads that file too) and it applies to both.
# The backend's settings.json then needs `model_dir` (`/models` under Docker).
MODEL_DIR=

# Optional: where Ollama's own model store lives, if not ./.ollama alongside this
# file — same reasoning as MODEL_DIR.
OLLAMA_DATA_DIR=

# How much context the model gets. Must match `ollama.context_length` in the backend's
# settings.json — see ../backend/README.md.
OLLAMA_CONTEXT_LENGTH=32768

# How long the model stays loaded in VRAM after the last request before Ollama
# unloads it.
OLLAMA_KEEP_ALIVE=2h

# How long Ollama waits for the model to finish loading before giving up — the
# default can be too short for a large, mostly-CPU-offloaded model.
OLLAMA_LOAD_TIMEOUT=15m

# Copy to `.env` in the repo root (gitignored) and edit. Only Docker Compose and start-docker.sh read
# it — the backend itself reads no environment variables, every backend setting is in
# backend/data/settings.json (see backend/README.md). Every variable is optional.
#
# What the app needs (the llama.cpp it runs is set up in the app: the setup wizard, then the
# Models page — context, KV cache, GPU layers, MTP, projector and sampling are not set here):

# Folder the .gguf model files live in, if not ./llm — an absolute path. The backend mounts it
# as /models (under Docker the app's folder chooser can only pick what the container sees, so this
# decides what is reachable) (writable: Hugging Face downloads land there), and the optional Ollama container
# mounts it too. Handy for keeping large models on faster storage than this project itself.
# The backend's settings.json then needs `model_dir` (`/models` under Docker).
MODEL_DIR=

# Which GPU the backend container gets, for the llama.cpp it runs. start-docker.sh picks one by
# itself (amd, nvidia, dri for Intel and others, none for CPU only); set this to override it.
#LLM_GPU=

# Only if you also want Ollama, as a second model provider next to the built-in llama.cpp: set to
# `ollama` to start the Ollama container (llm/compose.yaml). Everything below is for that container.
#COMPOSE_PROFILES=ollama

# --- Ollama container only ---

# Filename of a .gguf model to register as `local-llm` on container start — it must sit in
# MODEL_DIR. Leave empty to add models from the app instead (pull one, or import any .gguf).
MODEL_FILE=

# A mmproj/CLIP projector .gguf, paired with MODEL_FILE, to give the model vision.
MMPROJ_FILE=

# Where Ollama's own model store lives, if not ./.ollama alongside this file.
OLLAMA_DATA_DIR=

# How much context the model gets. Must match `ollama.context_length` in the backend's
# settings.json — see backend/README.md.
OLLAMA_CONTEXT_LENGTH=32768

# How long the model stays loaded in VRAM after the last request before Ollama unloads it.
OLLAMA_KEEP_ALIVE=2h

# How long Ollama waits for the model to finish loading before giving up — the default can be
# too short for a large, mostly-CPU-offloaded model.
OLLAMA_LOAD_TIMEOUT=15m

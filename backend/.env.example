# Copy to .env and edit — see README.md's Environment variables table for the full
# list and defaults. Only needed for a native `cargo run`; Docker sets these itself
# (see the repo root's compose.yaml).

# Postgres connection string, without a database name.
DATABASE_URL=postgres://postgres:postgres@localhost:5432

# Database name — created automatically if it doesn't exist.
DATABASE_NAME=llm_tulpa
